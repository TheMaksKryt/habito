# Habito — пример конфигурации. Скопируйте в .env и при необходимости измените.
# Все значения ниже — заведомо фиктивные dev-значения; реальные секреты в репозиторий не попадают.

# PostgreSQL (контейнер postgres в docker-compose.yml)
POSTGRES_USER=habito
POSTGRES_PASSWORD=dev-change-me
POSTGRES_DB=habito

# Хостовые порты хранилищ. Если 5432/6379 заняты другим проектом — поменяйте
# здесь и синхронно в DATABASE_URL/REDIS_URL ниже (внутри compose-сети конфликтов
# нет: api всегда ходит на postgres:5432 / redis:6379 по именам сервисов).
POSTGRES_PORT=5432
REDIS_PORT=6379

# Строка подключения для api. Внутри compose хост — `postgres`, при локальном dev — `localhost`.
DATABASE_URL=postgresql://habito:dev-change-me@localhost:5432/habito

# Redis. Внутри compose хост — `redis`.
REDIS_URL=redis://localhost:6379

# API
API_PORT=3333
APP_VERSION=dev

# Публичный адрес API для браузера (public runtime config — дефолт обязан быть непустым, см. конституцию)
NUXT_PUBLIC_API_URL=http://localhost:3333
# Внутрисетевой адрес API для SSR внутри compose (split-horizon; пусто = использовать публичный)
NUXT_INTERNAL_API_URL=
